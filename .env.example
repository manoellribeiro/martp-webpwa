# Mapbox public access token (pk.*), the same one the Android app reads as MAPBOX_API_KEY.
# A MAPBOX_API_KEY environment variable (GitHub Actions secret) takes precedence over this file.
# Restrict the token to this site's URLs in the Mapbox account, since it ships in the client bundle.
MAPBOX_API_KEY=

# Martp API base URL, without a trailing slash. Defaults to http://localhost:8080 (the local
# Spring Boot server), like the Android app.
PUBLIC_MARTP_API_URL=

# Firebase web app config and reCAPTCHA Enterprise site key, used for App Check: every Martp
# API request sends a token in the X-Firebase-AppCheck header. In development the debug
# provider is used: register the debug token the browser console prints in the Firebase console.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Put this one in .env.development instead (untracked, read only by `pnpm dev`), so it is never
# built into the site. A UUID you register once in the Firebase console (App Check → Apps →
# web app → Manage debug tokens); every browser in development then uses it.
# PUBLIC_APPCHECK_DEBUG_TOKEN=
