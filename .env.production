# Where the production build is served. Not secret, so this file is committed.
# GitHub Pages project site for now; for a custom domain (e.g. https://martp.app),
# set PUBLIC_SITE_URL to it and leave BASE_PATH empty.
PUBLIC_SITE_URL=https://manoellribeiro.github.io/martp-webpwa
BASE_PATH=/martp-webpwa

# Martp API (HTTPS, with CORS allowing PUBLIC_SITE_URL's origin). TODO: set once it is hosted;
# empty falls back to http://localhost:8080.
PUBLIC_MARTP_API_URL=

